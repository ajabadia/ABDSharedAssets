{
  "name": "@abdsynths/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fuente Unica de la Verdad (Zero-Copy) para la suite ABDSynths: design tokens, temas, componentes UI, contratos y assets.",
  "exports": {
    "./styles": "./styles/index.css",
    "./styles/*": "./styles/*",
    "./contracts/*": "./contracts/*",
    "./docs/*": "./docs/*",
    "./components": "./components/index.js",
    "./components/*": "./components/*",
    "./utils": "./utils/index.js",
    "./utils/*": "./utils/*",
    "./icons/*": "./icons/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "styles",
    "contracts",
    "brands",
    "models",
    "icons",
    "docs",
    "demo",
    "components",
    "assets"
  ],
  "scripts": {
    "demo": "vite . --port 5199",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:barrel": "node tests/audit/barrel.js",
    "smoke:a11y": "node smoke/a11y-smoke.mjs",
    "generate:mod-contracts": "python scripts/generate_modulation_contracts.py",
    "check:mod-contracts": "python scripts/generate_modulation_contracts.py --check"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "jsdom": "^24.0.0",
    "mermaid": "^12.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}