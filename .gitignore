# OS files
.DS_Store
Thumbs.db
Desktop.ini

# macOS metadata
__MACOSX/

# Temporary / downloaded assets
temp/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~
# Reference copies (not part of the shared library)
_review/

# JS dependencies
node_modules/

# Logs efimeros de sesion (servidores de demo, builds locales)
serve-err.log
serve-out.log
*.log

# Copia espejo de la WebUI de ABDBankManager (la canonica vive en su repo)
abdbank/

# --- Scratch de sesiones (nunca producto) ---
# Parches y sondas de una sesion de agente, y lo que las herramientas
# dejan al escribir en la raiz. Mismas reglas que la raiz del workspace.
/_*.py
/_*.mjs
/_*.sh
# Los generadores de `scripts/` son python, y python escribe la cache de
# bytes al lado del script: `scripts/__pycache__/`. Sin la barra delante,
# que lo ancla a la raiz y deja fuera justo ese.
__pycache__/
# Copias de seguridad de un parche a medio aplicar
*.bak

# Local Node recovery/install directories
node_modules_ok/
node_modules_roto_v10/
